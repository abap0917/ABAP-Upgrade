{
  "mcpServers": {
    "mcp-abap-adt": {
      "command": "node",
      "args": [
        "C:/path/to/your/mcp-abap-adt/dist/server/launcher.js",
        "--env-path=C:/your/project/mcp-pack/.env",
        "--exposition=readonly,high,customizing,debug"
      ],
      "env": { "NODE_TLS_REJECT_UNAUTHORIZED": "0" },
      "disabled": false
    }
  }
}
