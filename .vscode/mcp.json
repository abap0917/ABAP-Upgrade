{
  "$schema": "https://json.schemastore.org/mcp.json",
  "servers": {
    "mcp-abap-adt": {
      "type": "stdio",
      "command": "node",
      "args": [
        "C:/path/to/your-abap-mcp/adt-dev/dist/server/launcher.js",
        "--env-path=C:/path/to/your-abap-mcp/mcp-pack/.env"
      ],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "SAP_RFC_BACKEND": "soap"
      }
    }
  }
}
