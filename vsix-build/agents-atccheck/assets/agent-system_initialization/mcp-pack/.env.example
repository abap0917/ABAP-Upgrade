# ============================================================================
# MCP ABAP ADT — SAP 连接配置模板
# 使用方法: 复制本文件为同目录下的 .env,然后填写你真实的 SAP 连接信息。
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# 注意: 本文件包含占位值,直接使用会无法连接 SAP。
#       所有 agent 的配置文件都指向同目录下的 .env,只需维护这一个文件。
#       不要把真实的 .env 提交到 git!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SAP 系统连接 (必填)
# ----------------------------------------------------------------------------

# SAP 系统 URL
#   ABAP Cloud (BTP):   https://<guid>.abap.<region>.hana.ondemand.com
#   On-Premise:         http(s)://<host>:<port>
SAP_URL=https://your-sap-system.example.com

# SAP Client (基本认证必填)
SAP_CLIENT=100

# SAP 语言 (可选)
# SAP_LANGUAGE=en

# ----------------------------------------------------------------------------
# 2. 系统类型 (决定哪些工具可见)
#    cloud  = ABAP Cloud / BTP (默认)
#    onprem = On-Premise S/4HANA / ECC (BASIS >= 7.50)
#    legacy = Legacy ECC (BASIS < 7.50)
# ----------------------------------------------------------------------------
SAP_SYSTEM_TYPE=onprem

# 连接方式: http (默认) 或 rfc (legacy 系统,需 SAP NW RFC SDK)
# SAP_CONNECTION_TYPE=http

# ----------------------------------------------------------------------------
# 3. 认证方式 (二选一)
# ----------------------------------------------------------------------------

# 方式 A: Basic Auth (On-Premise / Legacy)
SAP_AUTH_TYPE=basic
SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# 方式 B: JWT / XSUAA (ABAP Cloud / BTP)
# 注意: 取消注释后,UAA 三项也必填 —— 即使已预置 SAP_JWT_TOKEN,服务器启动时
# broker 初始化仍需要它们 (AuthorizationCodeProvider 校验);缺失会退回
# inspection-only 模式。
# SAP_AUTH_TYPE=jwt
# SAP_JWT_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
# SAP_REFRESH_TOKEN=your_refresh_token_here        # 可选,用于自动续期
# SAP_UAA_URL=https://your-tenant.authentication.example.com
# SAP_UAA_CLIENT_ID=your-client-id
# SAP_UAA_CLIENT_SECRET=your-client-secret

# ----------------------------------------------------------------------------
# 4. On-Premise 系统上下文 (onprem 系统上 Create/Update 必填)
#    masterSystem 用于正确绑定 transport request;缺失会导致 403。
# ----------------------------------------------------------------------------
SAP_MASTER_SYSTEM=DEV
# SAP_RESPONSIBLE=your_username     # 可选,缺省回退到 SAP_USERNAME

# ----------------------------------------------------------------------------
# 5. 可选调优
# ----------------------------------------------------------------------------

# 自签名证书 (仅开发环境!)
# TLS_REJECT_UNAUTHORIZED=0

# 超时 (毫秒)
# SAP_TIMEOUT_DEFAULT=45000
# SAP_TIMEOUT_CSRF=15000
# SAP_TIMEOUT_LONG=60000

# 敏感数据提取防护 (可选): 拦截 GetTableContents / GetSqlQuery 访问敏感表
# SC4SAP_POLICY=on                  # on | strict | standard | minimal | custom
# SC4SAP_POLICY_PROFILE=strict
